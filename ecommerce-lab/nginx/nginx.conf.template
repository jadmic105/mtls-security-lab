# nginx for the e-commerce mTLS lab.
# __RUN__ and __CERTS__ are replaced with absolute paths by scripts/start_lab.sh.
#
#   :8443  edge             public HTTPS for customers (TLS only, no client cert)
#   :9101  orders sidecar   mTLS, only "edge" may call
#   :9102  payments sidecar mTLS, "orders" may call /charge, "edge" may call /webhooks/
#   :9103  PSP gateway      mTLS against the PSP CA, only "merchant-payments" may call
#
# Each sidecar verifies the client certificate, applies an allow-list on the
# certificate's CN, and forwards the verified identity to the app in X-Client-CN.
# The apps listen on 127.0.0.1 only, so the header can't be set by anyone else.

worker_processes 1;
pid __RUN__/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log __RUN__/access.log;
    client_body_temp_path __RUN__/tmp/body;
    proxy_temp_path       __RUN__/tmp/proxy;
    fastcgi_temp_path     __RUN__/tmp/fastcgi;
    uwsgi_temp_path       __RUN__/tmp/uwsgi;
    scgi_temp_path        __RUN__/tmp/scgi;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;
    server_tokens off;

    # CN of the verified client certificate ("" when there is none)
    map $ssl_client_s_dn $client_cn {
        default "";
        "~(^|,)CN=(?<cn>[^,]+)" $cn;
    }

    # Authorization policy: which identity may call which service
    map $client_cn $orders_allowed           { default 0; edge 1; }
    map $client_cn $payments_charge_allowed  { default 0; orders 1; }
    map $client_cn $payments_webhook_allowed { default 0; edge 1; }
    map $client_cn $psp_allowed              { default 0; merchant-payments 1; }

    # ---------------------------------------------------------------- edge
    server {
        listen 127.0.0.1:8443 ssl;
        server_name localhost;

        ssl_certificate     __CERTS__/edge.crt;
        ssl_certificate_key __CERTS__/edge.key;

        add_header Strict-Transport-Security "max-age=63072000" always;
        client_max_body_size 16k;

        # Edge -> orders over mTLS, presenting the edge identity
        location /api/ {
            proxy_pass https://127.0.0.1:9101;
            proxy_ssl_certificate         __CERTS__/edge.crt;
            proxy_ssl_certificate_key     __CERTS__/edge.key;
            proxy_ssl_trusted_certificate __CERTS__/internal-ca.crt;
            proxy_ssl_verify on;
            proxy_ssl_name orders.internal;
            proxy_ssl_server_name on;
        }

        # Payment-provider webhooks arrive at the public edge, then go to payments over mTLS
        location /webhooks/ {
            proxy_pass https://127.0.0.1:9102;
            proxy_ssl_certificate         __CERTS__/edge.crt;
            proxy_ssl_certificate_key     __CERTS__/edge.key;
            proxy_ssl_trusted_certificate __CERTS__/internal-ca.crt;
            proxy_ssl_verify on;
            proxy_ssl_name payments.internal;
            proxy_ssl_server_name on;
        }

        location / {
            return 404;
        }
    }

    # ------------------------------------------------------- orders sidecar
    server {
        listen 127.0.0.1:9101 ssl;
        server_name orders.internal;

        ssl_certificate        __CERTS__/orders.crt;
        ssl_certificate_key    __CERTS__/orders.key;
        ssl_client_certificate __CERTS__/internal-ca.crt;
        ssl_verify_client on;
        ssl_verify_depth 1;

        location / {
            if ($orders_allowed = 0) {
                return 403;
            }
            proxy_pass http://127.0.0.1:8001;
            proxy_set_header X-Client-CN $client_cn;
        }
    }

    # ----------------------------------------------------- payments sidecar
    server {
        listen 127.0.0.1:9102 ssl;
        server_name payments.internal;

        ssl_certificate        __CERTS__/payments.crt;
        ssl_certificate_key    __CERTS__/payments.key;
        ssl_client_certificate __CERTS__/internal-ca.crt;
        ssl_verify_client on;
        ssl_verify_depth 1;

        location = /charge {
            if ($payments_charge_allowed = 0) {
                return 403;
            }
            proxy_pass http://127.0.0.1:8002;
            proxy_set_header X-Client-CN $client_cn;
        }

        location /webhooks/ {
            if ($payments_webhook_allowed = 0) {
                return 403;
            }
            proxy_pass http://127.0.0.1:8002;
            proxy_set_header X-Client-CN $client_cn;
        }

        location / {
            return 404;
        }
    }

    # ------------------------------------------- mock payment provider (PSP)
    # A separate organisation with its own CA. Our internal certificates mean nothing here.
    server {
        listen 127.0.0.1:9103 ssl;
        server_name gateway.psp.example;

        ssl_certificate        __CERTS__/psp-gateway.crt;
        ssl_certificate_key    __CERTS__/psp-gateway.key;
        ssl_client_certificate __CERTS__/psp-ca.crt;
        ssl_verify_client on;
        ssl_verify_depth 1;

        location / {
            if ($psp_allowed = 0) {
                return 403;
            }
            proxy_pass http://127.0.0.1:8003;
            proxy_set_header X-Client-CN $client_cn;
        }
    }
}
